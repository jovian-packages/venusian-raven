{
    "name": "jovian/venusian-raven",
    "description": "Raven toolkit driver for Venusian Topside: opens Raven windows and builds Topside's primitives from Raven widgets through ext-raven.",
    "version": "0.11.0",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "topside",
        "toolkit",
        "raven",
        "gui",
        "vulkan"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-raven/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-raven/issues",
        "source": "https://github.com/jovian-packages/venusian-raven"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-raven": "^0.11.0",
        "venusian-surface/toolkits": "^0.11.0",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian/framework": "^0.11.0",
        "venusian/topside": "^0.11.0"
    },
    "suggest": {
        "ext-appkit": "On macOS, folds the event loop's descriptor into Cocoa's run loop, where Raven waits: a loop wake ends Raven's wait at once instead of within raven.wait_slice_ms."
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Toolkits\\Raven\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Toolkits\\Raven\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Toolkits\\Raven\\Providers\\VenusianRavenServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
